# ─────────────────────────────────────────────
# Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────

# Required for deployment (also set as Workers Builds variables)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Enables Claude Code's GitHub MCP server (repo read scope is sufficient)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Public origin ────────────────────────────────────────────────────────────
# No trailing slash. sitemap.xml, robots.txt and og: tags build absolute links
# from this. Locally, match your portless host (https://frontier-terminal.localhost).
# NUXT_PUBLIC_APP_URL=http://localhost:3000

# ── PostHog ──────────────────────────────────────────────────────────────────
# Project token (phc_…). Public by design; production sets it in wrangler.toml
# [vars]. Unset, no analytics load. Under `nuxt dev` the SDK loads but opts out.
# NUXT_PUBLIC_POSTHOG_KEY=

# ── Fleet (portfolio dashboard) ──────────────────────────────────────────────
# Bearer the `fleet` dashboard presents to GET /api/fleet for this app's
# counters. Leave unset and the route 404s — the app is simply not on the
# dashboard. 32+ characters: openssl rand -base64 32. In production this is a
# Worker secret (`wrangler secret put NUXT_FLEET_TOKEN`); _PREVIOUS is only set
# while rotating, see server/utils/fleet-auth.ts.
# NUXT_FLEET_TOKEN=
# NUXT_FLEET_TOKEN_PREVIOUS=

# ── Owner mail (weekly thesis digest, press brief) ──────────────────────────
# These live in wrangler.toml [vars] in production (not secrets) and need the
# [[send_email]] OWNER_EMAIL binding there too; locally there is no binding, so
# those mails are skipped. Use a ROLE address on your own zone, forwarded by
# Email Routing: wrangler.toml is public.
# NUXT_OWNER_EMAIL_TO=
# NUXT_OWNER_EMAIL_FROM=

# ── SEC fair-access contact ──────────────────────────────────────────────────
# sec.gov requires a contact email in the User-Agent of every request
# (layers/terminal/server/pipeline/fetch.ts). Unset, the two EDGAR sources are skipped with a
# 'failed' run rather than fetched anonymously. In production this is a Worker
# secret: `wrangler secret put NUXT_SEC_CONTACT_EMAIL`.
# NUXT_SEC_CONTACT_EMAIL=

# ── Judge routine ────────────────────────────────────────────────────────────
# Bearer the cloud judge routine (.claude/routines/judge.md) presents to
# GET /api/judge/pending and POST /api/judge/alerts. Unset and both routes 404.
# 32+ characters: openssl rand -base64 32. In production a Worker secret
# (`wrangler secret put NUXT_JUDGE_TOKEN`); the same value goes into the
# routine's cloud environment as JUDGE_TOKEN, beside JUDGE_BASE_URL.
# NUXT_JUDGE_TOKEN=

# ── Alert webhooks ───────────────────────────────────────────────────────────
# Derives each licensee webhook's signing secret (bun run webhooks:add). Unset =
# the webhook outbox does nothing. 32+ characters: openssl rand -base64 32.
# scripts/webhooks.ts reads it from here too, for the local database. In
# production it is a Worker secret (`wrangler secret put NUXT_WEBHOOK_SIGNING_KEY`).
# NUXT_WEBHOOK_SIGNING_KEY=
